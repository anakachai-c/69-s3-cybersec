# REST API

@baseUrl = http://localhost:9093

@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@adminFirstname = {{$dotenv ADMIN_FIRSTNAME}}
@adminLastname = {{$dotenv ADMIN_LASTNAME}}
@adminResetToken = {{$dotenv ADMIN_RESET_TOKEN}}
@adminNewPassword = {{$dotenv ADMIN_NEW_PASSWORD}}
@rememberMe = {{$dotenv REMEMBER_ME}}
@adminToken = {{$dotenv ADMIN_TOKEN}}

@userEmail = {{$dotenv USER_EMAIL}}
@userPassword = {{$dotenv USER_PASSWORD}}
@userUsername = {{$dotenv USER_USERNAME}}
@userIdentifier = {{$dotenv USER_IDENTIFIER}}
@userResetCode = {{$dotenv USER_RESET_CODE}}
@userNewPassword = {{$dotenv USER_NEW_PASSWORD}}
@userToken = {{$dotenv USER_TOKEN}}

# 1. ADMIN SECTION
### 1.1 Login Admin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": {{rememberMe}}
}

### 1.2 Signup Admin
# ใช้เฉพาะตอนที่ระบบยังไม่มี Admin คนแรก
# หากมี Admin อยู่แล้ว อาจได้รับ HTTP 400
POST {{baseUrl}}/admin/register
Content-Type: application/json

{
  "firstname": "{{adminFirstname}}",
  "lastname": "{{adminLastname}}",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 1.3 Forgot Password Admin
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### 1.3.1 Reset Password Admin
# ต้องนำ Reset Token ที่ได้รับจาก Forgot Password ใส่ใน ADMIN_RESET_TOKEN
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "{{adminResetToken}}",
  "password": "{{adminNewPassword}}"
}

### 1.4 Profile Admin
# ต้องนำ Token ที่ได้รับจาก Login ใส่ใน ADMIN_TOKEN
GET {{baseUrl}}/admin/me
Authorization: Bearer {{adminToken}}

# 2. USER SECTION
### 2.1 Login User
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{userIdentifier}}",
  "password": "{{userPassword}}"
}

### 2.2 Signup User
# หาก Email หรือ Username มีอยู่แล้ว อาจได้รับ HTTP 400
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{userUsername}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.3 Forgot Password User
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### 2.3.1 Reset Password User
# ต้องนำ Reset Code ที่ได้รับจาก Forgot Password ใส่ใน USER_RESET_CODE
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "{{userResetCode}}",
  "password": "{{userNewPassword}}",
  "passwordConfirmation": "{{userNewPassword}}"
}

### 2.4 Profile User
# ต้องนำ JWT ที่ได้รับจาก Login ใส่ใน USER_TOKEN
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userToken}}