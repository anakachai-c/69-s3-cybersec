# REST API

@baseUrl = http://localhost:9093

@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@adminFirstname = {{$dotenv ADMIN_FIRSTNAME}}
@adminLastname = {{$dotenv ADMIN_LASTNAME}}
@adminResetToken = {{$dotenv ADMIN_RESET_TOKEN}}
@adminNewPassword = {{$dotenv ADMIN_NEW_PASSWORD}}
@rememberMe = {{$dotenv REMEMBER_ME}}
@adminToken = {{$dotenv ADMIN_TOKEN}}

@userEmail = {{$dotenv USER_EMAIL}}
@userPassword = {{$dotenv USER_PASSWORD}}
@userUsername = {{$dotenv USER_USERNAME}}
@userIdentifier = {{$dotenv USER_IDENTIFIER}}
@userResetCode = {{$dotenv USER_RESET_CODE}}
@userNewPassword = {{$dotenv USER_NEW_PASSWORD}}
@userToken = {{$dotenv USER_TOKEN}}

@studentId = {{$dotenv STUDENT_ID}}
@studentName = {{$dotenv STUDENT_NAME}}
@studentNewName = {{$dotenv STUDENT_NEW_NAME}}
@studentMobile = {{$dotenv STUDENT_MOBILE}}
@studentCardId = {{$dotenv STUDENT_CARD_ID}}

@subjectId = {{$dotenv SUBJECT_ID}}
@subjectName = {{$dotenv SUBJECT_NAME}}
@subjectNewName = {{$dotenv SUBJECT_NEW_NAME}}

@teacherId = {{$dotenv TEACHER_ID}}
@teacherName = {{$dotenv TEACHER_NAME}}
@teacherNewName = {{$dotenv TEACHER_NEW_NAME}}

@contentPublishedAt = {{$dotenv CONTENT_PUBLISHED_AT}}

# 1. ADMIN SECTION
### 1.1 Login Admin
# @name adminLogin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": {{rememberMe}}
}

### 1.2 Signup Admin
# ใช้เฉพาะตอนที่ระบบยังไม่มี Admin คนแรก
# ถ้ามี Admin แล้ว Request นี้อาจตอบกลับ 400
POST {{baseUrl}}/admin/register
Content-Type: application/json

{
  "firstname": "{{adminFirstname}}",
  "lastname": "{{adminLastname}}",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 1.3 Forgot Password Admin
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### 1.3.1 Reset Password Admin
# นำ resetPasswordToken ที่ได้รับจาก Forgot Password มาใส่
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "{{adminResetToken}}",
  "password": "{{adminNewPassword}}"
}

### 1.4 Profile Admin
# ต้องยิง 1.1 Login Admin ให้สำเร็จก่อน
GET {{baseUrl}}/admin/me
Authorization: Bearer {{adminToken}}

# 2. USER SECTION
### 2.1 Login User
# @name userLogin
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{userIdentifier}}",
  "password": "{{userPassword}}"
}

### 2.2 Signup User
# ใช้สร้างบัญชีครั้งแรก
# สมัครซ้ำด้วย Email หรือ Username เดิมจะได้ 400
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{userUsername}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.3 Forgot Password User
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### 2.3.1 Reset Password User
# นำ code ที่ได้รับจาก Forgot Password มาใส่
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "{{userResetCode}}",
  "password": "{{userNewPassword}}",
  "passwordConfirmation": "{{userNewPassword}}"
}

### 2.4 Profile User
# ต้องยิง 2.1 Login User ให้สำเร็จก่อน
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userToken}}

# 3. CONTENT SECTION
# 3.1 STUDENT
### 3.1.1 Create Student
POST {{baseUrl}}/api/students
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "{{studentName}}",
    "mobile": "{{studentMobile}}",
    "cardId": "{{studentCardId}}",
    "publishedAt": "{{contentPublishedAt}}"
  }
}

### 3.1.2 List All Students
GET {{baseUrl}}/api/students
Authorization: Bearer {{userToken}}

### 3.1.3 List Student with ID
GET {{baseUrl}}/api/students/{{studentId}}
Authorization: Bearer {{userToken}}

### 3.1.4 Update Student
PUT {{baseUrl}}/api/students/{{studentId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "{{studentNewName}}"
  }
}

# 3.2 SUBJECT
### 3.2.1 Create Subject
POST {{baseUrl}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "{{subjectName}}",
    "publishedAt": "{{contentPublishedAt}}"
  }
}

### 3.2.2 List All Subjects
GET {{baseUrl}}/api/subjects
Authorization: Bearer {{userToken}}

### 3.2.3 List Subject with ID
GET {{baseUrl}}/api/subjects/{{subjectId}}
Authorization: Bearer {{userToken}}

### 3.2.4 Update Subject
PUT {{baseUrl}}/api/subjects/{{subjectId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "{{subjectNewName}}"
  }
}

# 3.3 TEACHER
### 3.3.1 Create Teacher
POST {{baseUrl}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "{{teacherName}}",
    "publishedAt": "{{contentPublishedAt}}"
  }
}

### 3.3.2 List All Teachers
GET {{baseUrl}}/api/teachers
Authorization: Bearer {{userToken}}

### 3.3.3 List Teacher with ID
GET {{baseUrl}}/api/teachers/{{teacherId}}
Authorization: Bearer {{userToken}}

### 3.3.4 Update Teacher
PUT {{baseUrl}}/api/teachers/{{teacherId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "data": {
    "name": "{{teacherNewName}}"
  }
}